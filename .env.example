# Local development. Do not commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/hostkit?schema=public"
# Optional. Direct (non-pooled) URL for prisma migrate on hosted Postgres.
# DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/hostkit?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# The public address, for links in emails and share URLs. Set it in
# production so a link can never be steered by a request's Host header.
# SITE_URL="https://host-kit-one.vercel.app"

# Optional. Venue search on the web (Create → Venue). Google Places wins
# when GOOGLE_MAPS_API_KEY is set; otherwise the Apple Maps Server API, if
# those keys are set. Without either, the UI falls back to typing an address
# by hand. iOS searches MapKit directly and needs none of this.
#
# Google — prefer this. Cloud Console → APIs & Services → enable Places API
# (New) → Credentials → API key. Restrict the key to Places API (New).
# Text Search (New) is POST https://places.googleapis.com/v1/places:searchText
# and a field mask is required. Places SKUs have a monthly free usage cap
# (this replaced the old $200 credit). Set the key on Vercel and redeploy.
# GOOGLE_MAPS_API_KEY="AIza..."
#
# Apple — used only when Google isn't set. developer.apple.com → Certificates,
# IDs & Profiles → Keys → Maps. Paste the .p8 contents with newlines as \n.
# APPLE_MAPS_TEAM_ID="ABCDE12345"
# APPLE_MAPS_KEY_ID="XYZ987WVU6"
# APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Email. Two ways, and you need one of them for sign-up to work at all:
# confirmation is required, so without a transport new accounts are refused.
#
# 1. Resend. Authenticates a DOMAIN, so until you verify one at
#    resend.com/domains it delivers only to your own address — everyone
#    else's sign-up fails. Best once you own a domain.
# RESEND_API_KEY="re_..."
# RESEND_FROM="HostKit <events@your-domain.com>"
#
# 2. SMTP. Authenticates a MAILBOX, so it needs no domain and no DNS, and
#    delivers to anyone. A Gmail address with an app password works today
#    (myaccount.google.com -> Security -> App passwords); so does Zoho,
#    Fastmail, or any provider's SMTP endpoint.
#    Port defaults to 587 (STARTTLS); use 465 for implicit TLS.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="your-16-character-app-password"
# SMTP_FROM="HostKit <you@gmail.com>"
#
# Resend wins if both are set. Without either, blasts are recorded and the
# host copies the message and recipients by hand.

# Optional. A model, for the few jobs deterministic code cannot do: drafting a
# plan for an event type nobody wrote a template for, reading an event out of a
# flyer, phrasing a message. Turnout and campus conflicts are arithmetic and a
# query — they never go near this.
#
# Without a key it is simply off and every caller falls back to the heuristics
# in lib/plan.ts and lib/runsheet.ts, which stay the floor under it.
# AI_MODEL defaults to claude-sonnet-5, chosen because the first caller sits in
# the event-create flow where a slow answer is worse than a plainer one.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-sonnet-5"

# Optional. Uploaded photos (profile pictures, event covers) go to Vercel
# Blob — Vercel dashboard → Storage → Blob. Without it they're stored in
# Postgres and served from /api/images, which is fine for local development.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional. Texts the one-time code that verifies a phone number, via Twilio
# (console.twilio.com → Account SID, Auth Token, and a purchased number).
# Without these the code is printed to the server log and, in development,
# returned to the client so the flow still works.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+16175550100"

# Optional. Guards /api/cron/campus-sync (official campus events). Vercel
# sends it automatically on the daily schedule in vercel.json. Without it
# the route only answers in development; the background refresh of stale
# feeds needs nothing.
# CRON_SECRET="generate-with-openssl-rand-hex-32"

# Later, with a paid Apple developer team: push notifications to the iOS
# app. developer.apple.com → Keys → Apple Push Notifications service key
# (.p8, paste with newlines as \n). APNS_ENV is sandbox or production.
# Without these, notifications stay in the Inbox and email.
# APNS_TEAM_ID="ABCDE12345"
# APNS_KEY_ID="XYZ987WVU6"
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_BUNDLE_ID="app.hostkit.ios"
# APNS_ENV="sandbox"

# Optional Claude / ChatGPT MCP connector. See docs/mcp.md.
# Exact HTTPS origin, no trailing slash. Leave unset to disable MCP.
MCP_PUBLIC_ORIGIN=
# JSON array of pre-registered OAuth clients: id, name, optional secret,
# and redirectUris (exact HTTPS callbacks from each AI app).
MCP_CLIENTS_JSON=[]
# Optional additional exact Origin headers, comma separated. No wildcard.
MCP_ALLOWED_ORIGINS=
