# Local development. Do not commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/hostkit?schema=public"
# Optional. Direct (non-pooled) URL for prisma migrate on hosted Postgres.
# DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/hostkit?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Optional. Venue search on the web (Create → Venue) via the Apple Maps
# Server API. developer.apple.com → Certificates, IDs & Profiles → Keys →
# Maps. Paste the .p8 contents with newlines as \n. iOS searches MapKit
# directly and needs none of this.
# APPLE_MAPS_TEAM_ID="ABCDE12345"
# APPLE_MAPS_KEY_ID="XYZ987WVU6"
# APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional. Sending blasts to registered guests via Resend. Without these,
# blasts are recorded and the host copies the message and recipients.
# RESEND_API_KEY="re_..."
# RESEND_FROM="HostKit <events@your-domain.com>"

# Optional. Uploaded photos (profile pictures, event covers) go to Vercel
# Blob — Vercel dashboard → Storage → Blob. Without it they're stored in
# Postgres and served from /api/images, which is fine for local development.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional. Texts the one-time code that verifies a phone number, via Twilio
# (console.twilio.com → Account SID, Auth Token, and a purchased number).
# Without these the code is printed to the server log and, in development,
# returned to the client so the flow still works.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+16175550100"
