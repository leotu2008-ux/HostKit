// HostKit — event planning, end-to-end.
// Money is ALWAYS stored as integer cents. Never floats. See lib/money.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts. Every user is a host planning an event; there is no supply side.
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  /// Bumped by a password reset. Tokens and sessions carry the version
  /// they were issued at; older ones stop working (lib/api/token.ts).
  sessionVersion   Int       @default(0)
  /// The `.edu` domain the account signed up with, e.g. "babson.edu". Set
  /// means "student"; lib/schools.ts turns it into a school and a home city.
  schoolDomain     String?
  classYear        Int?
  bio              String?
  /// Where they work, for hosts who aren't students (or are, and work too).
  company          String?
  /// Social handles, stored bare (no "@", no URL) — lib/socials.ts builds the links.
  xHandle          String?
  linkedinHandle   String?
  instagramHandle  String?
  /// Profile picture, stored by lib/images.ts (Vercel Blob, or /api/images/:id).
  imageUrl         String?
  /// E.164, set only once a code sent to it has been confirmed.
  phone            String?   @unique
  phoneVerifiedAt  DateTime?
  /// Whether their name and photo may appear in "who's going" on event pages.
  showOnGuestLists Boolean   @default(true)
  /// Set once a link sent to the address was opened (lib/account.ts).
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())

  events             Event[]
  accountTokens      AccountToken[]
  registrations      Guest[]
  phoneVerifications PhoneVerification[]
  clubMemberships    ClubMember[]
  follows            Follow[]
  clubPosts          ClubPost[]
  notifications      Notification[]
  pushTokens         PushToken[]
}

/// A club or org that hosts events: a page people follow, run by its admins.
model Club {
  id           String   @id @default(cuid())
  /// ^[a-z0-9-]{3,30}$, lowercased, immutable once chosen.
  handle       String   @unique
  name         String
  blurb        String?
  imageUrl     String?
  coverUrl     String?
  /// Set on clubs synced from a school's official calendar
  /// ("<sourceKey>:<groupId>", lib/campus/sync.ts). Real organisations,
  /// nobody here runs them; their events come from the feed.
  sourceRef    String?  @unique
  isOfficial   Boolean  @default(false)
  /// The creator's school, when they're a student — surfaces the club and
  /// its events to that campus first.
  schoolDomain String?
  city         String?
  /// One of lib/club-format.ts CLUB_CATEGORIES ("social", "professional"…), for browsing.
  category     String?
  createdAt    DateTime @default(now())

  members   ClubMember[]
  followers Follow[]
  events    Event[]
  posts     ClubPost[]

  @@index([schoolDomain])
}

enum ClubRole {
  OWNER
  ADMIN
}

model ClubMember {
  clubId    String
  userId    String
  role      ClubRole @default(ADMIN)
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

/// An update a club's admins post to followers: a short note that lands in
/// their Inbox (and email) and stays on the club page.
model ClubPost {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  club   Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
}

model Follow {
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

/// Something that happened to you: lands in the Inbox always, goes out by
/// email and push when those are configured (lib/notify.ts).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// club_published | registration_request | registration_approved | waitlist_promoted | blast
  kind      String
  title     String
  body      String
  eventId   String?
  clubId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An APNs device token. Registered by the iOS app only when its push
/// entitlement is on (Info.plist HostKitPushEnabled).
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @default("ios")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time link on its way to an email address: a password reset or an
/// email verification. Only the hash is stored; used and expired rows are
/// swept by lib/account.ts.
model AccountToken {
  id        String    @id @default(cuid())
  userId    String
  /// "reset" | "verify"
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Sliding-window counters for the auth endpoints (lib/rate-limit.ts).
/// Kept in Postgres because serverless instances share no memory.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

/// A one-time code on its way to a phone number. Rows are short-lived:
/// confirmed or expired ones are deleted by lib/phone.ts.
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Uploaded image bytes — only used when Vercel Blob isn't configured, so
/// local development works without any storage service.
model Image {
  id          String   @id @default(cuid())
  bytes       Bytes
  contentType String
  createdAt   DateTime @default(now())
}

/// Who can see a live night. Drafts are unpublished regardless of this.
enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum TicketType {
  FREE
  PAID
}

enum CollaboratorKind {
  VENUE
  SPEAKER
  COHOST
}

enum CollaboratorStatus {
  PENDING
  CONFIRMED
  DECLINED
}

/// Where a collaborator came from: typed in by the host, picked from Apple
/// Maps on Create, or a booked catalog listing.
enum CollaboratorSource {
  MANUAL
  APPLE_MAPS
  CATALOG
}

// ---------------------------------------------------------------------------
// The event being planned. Everything else hangs off this.
// ---------------------------------------------------------------------------

/// HostKit is for student, professional and fun events — no weddings or
/// family occasions.
enum EventType {
  BIRTHDAY
  CORPORATE_OFFSITE
  LAUNCH_PARTY
  DINNER_PARTY
  FUNDRAISER
}

enum EventStatus {
  PLANNING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Event {
  id               String          @id @default(cuid())
  /// Null until the host signs in. Drafts are claimed via `claimToken`.
  ownerId          String?
  title            String
  type             EventType
  status           EventStatus     @default(PLANNING)
  /// Start of the night, including time of day. Null while still deciding.
  date             DateTime?
  /// Set when the host is flexible: `date` is the earliest acceptable day and
  /// `endDate` the latest. Lead-time scoring uses the earliest.
  endDate          DateTime?
  datesFlexible    Boolean         @default(false)
  /// Planned duration, used to price hourly listings against this event.
  durationHours    Int             @default(6)
  guestCount       Int
  city             String
  /// Place name and street address for device maps. `city` stays the scout area.
  address          String?
  lat              Float?
  lng              Float?
  budgetTotalCents Int
  vibe             String?
  description      String?
  ticketType       TicketType      @default(FREE)
  ticketPriceCents Int             @default(0)
  visibility       EventVisibility @default(UNLISTED)
  /// When true the night is live. Discover only lists PUBLIC + published.
  published        Boolean         @default(false)
  /// Lets a signed-out host keep editing a draft until they sign in to publish.
  claimToken       String?         @unique
  /// The host's school, copied at create (or claim). Surfaces the night to
  /// that school's students first; it never restricts who can attend.
  schoolDomain     String?
  /// A photo the host chose; when null the cover is drawn from the id.
  coverUrl         String?
  /// "Posted as" a club the owner manages. The owner stays the person.
  clubId           String?
  /// Registrations wait for the host's approval instead of going straight in.
  requiresApproval Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  owner            User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  club             Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  savedListings    SavedListing[]
  inquiries        Inquiry[]
  budgetCategories BudgetCategory[]
  budgetItems      BudgetItem[]
  tasks            Task[]
  outcome          EventOutcome?
  guests           Guest[]
  runSheetItems    RunSheetItem[]
  collaborators    EventCollaborator[]
  blasts           Blast[]

  @@index([ownerId])
  @@index([clubId])
  @@index([published, visibility, date])
  @@index([schoolDomain, published, date])
}

/// People and places the host is lining up, separate from catalog scouting.
model EventCollaborator {
  id         String             @id @default(cuid())
  eventId    String
  kind       CollaboratorKind
  name       String
  email      String?
  phone      String?
  website    String?
  detail     String?
  status     CollaboratorStatus @default(PENDING)
  source     CollaboratorSource @default(MANUAL)
  /// The provider's id (an Apple Maps place id, or a catalog listing id).
  externalId String?
  lat        Float?
  lng        Float?
  createdAt  DateTime           @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, kind])
}

/// One message from the host to a segment of the guest list. Recorded
/// whether it went out through the email provider or was copied by hand.
model Blast {
  id             String   @id @default(cuid())
  eventId        String
  /// "going" | "pending" | "everyone" — see lib/blasts.ts.
  segment        String
  subject        String
  body           String
  recipientCount Int
  /// "resend" when the provider sent it; "manual" when the host copied it.
  provider       String
  /// Guests also texted (Twilio), when the host asked for it.
  smsCount       Int      @default(0)
  sentAt         DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sentAt])
}

// ---------------------------------------------------------------------------
// Official campus events, pulled from each school's public calendar
// (lib/campus/sources.ts lists the feeds; lib/campus/sync.ts fills this).
// ---------------------------------------------------------------------------

/// One event from a school's official calendar. Separate from Event: nobody
/// hosts it here, there's no guest list, and the page to open is the school's.
model CampusEvent {
  id           String    @id @default(cuid())
  schoolDomain String
  /// Which feed it came from, e.g. "mit.edu/calendar" (lib/campus/sources.ts).
  sourceKey    String
  /// The feed's own id for the event (or event instance), unique per source.
  externalId   String
  title        String
  description  String?
  /// Wall-clock start in the school's time zone, encoded as UTC — the same
  /// convention as Event.date, so both apps format it the same way.
  startsAt     DateTime
  endsAt       DateTime?
  allDay       Boolean   @default(false)
  location     String?
  /// Listed for the school's own community: the feed shows the title and
  /// time to everyone but keeps the place behind a school sign-in.
  restricted   Boolean   @default(false)
  /// The club or department putting it on, when the feed says.
  host         String?
  /// Links the event to a synced Club (Club.sourceRef) when the feed names one.
  hostRef      String?
  /// The event's page on the school's site.
  url          String
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([sourceKey, externalId])
  @@index([schoolDomain, startsAt])
  @@index([hostRef])
}

/// When each feed last ran, and how it went.
model CampusSync {
  sourceKey    String    @id
  schoolDomain String
  lastRunAt    DateTime?
  lastOkAt     DateTime?
  lastError    String?
  eventCount   Int       @default(0)
}

// ---------------------------------------------------------------------------
// Catalog. Seeded data — venue and vendor owners never log in or list anything.
// Venues and vendors share one table because they share name, artwork, location,
// price and tags; splitting them would duplicate the entire search stack.
// ---------------------------------------------------------------------------

enum ListingKind {
  VENUE
  VENDOR
}

/// Vendor categories double as the planning checklist: templates declare which
/// of these an event type needs, and an event is "covered" for a category once
/// it has a BOOKED inquiry against a listing in it.
enum ListingCategory {
  VENUE
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  FLORALS
  MUSIC_DJ
  AV_PRODUCTION
  RENTALS
  BAR_SERVICE
  CAKE_DESSERT
  TRANSPORT
  STAFFING
  DECOR_STYLING
  INVITATIONS
}

/// How a listing's headline price is quoted. Turning this into a real cost for
/// a specific event is lib/scoring.ts's job — an hourly venue and a per-person
/// caterer are not comparable until they are both priced against one event.
enum PriceUnit {
  HOUR
  DAY
  PERSON
  FLAT
}

model Listing {
  id           String          @id @default(cuid())
  kind         ListingKind
  category     ListingCategory
  name         String
  description  String
  city         String
  neighborhood String?
  lat          Float
  lng          Float
  priceCents   Int
  priceUnit    PriceUnit
  /// Venues only. Null for vendors, who are constrained by lead time instead.
  capacityMin  Int?
  capacityMax  Int?
  /// Minimum days of notice this listing needs before the event date.
  leadTimeDays Int             @default(14)
  amenities    String[]        @default([])
  tags         String[]        @default([])
  rating       Float?
  reviewCount  Int             @default(0)
  createdAt    DateTime        @default(now())

  savedBy     SavedListing[]
  inquiries   Inquiry[]
  budgetItems BudgetItem[]

  @@index([city, category])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Shortlist and outreach. With no supply side there is no checkout: "booking"
// is a tracked outreach loop that ends by writing back into budget and tasks.
// ---------------------------------------------------------------------------

model SavedListing {
  id        String   @id @default(cuid())
  eventId   String
  listingId String
  note      String?
  rank      Int      @default(0)
  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([eventId, listingId])
  @@index([eventId])
}

enum InquiryStatus {
  DRAFT
  SENT
  REPLIED
  QUOTED
  BOOKED
  DECLINED
}

model Inquiry {
  id          String        @id @default(cuid())
  eventId     String
  listingId   String
  status      InquiryStatus @default(DRAFT)
  message     String
  quotedCents Int?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  budgetItem BudgetItem?

  @@unique([eventId, listingId])
  @@index([eventId, status])
}

// ---------------------------------------------------------------------------
// Budget. Categories are allocated up front from the event template; items are
// the real commitments that land against them.
// ---------------------------------------------------------------------------

/// Who produced a row: the planner, or a person. Without this a regenerate
/// cannot tell what it is safe to replace, which is why run sheets can only
/// be cleared wholesale today.
enum RowSource {
  GENERATED
  HUMAN
}

model BudgetCategory {
  id             String          @id @default(cuid())
  eventId        String
  category       ListingCategory
  name           String
  allocatedCents Int
  source         RowSource       @default(GENERATED)

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  @@unique([eventId, category])
  @@index([eventId])
}

model BudgetItem {
  id             String    @id @default(cuid())
  eventId        String
  categoryId     String
  label          String
  estimatedCents Int       @default(0)
  /// What it actually costs, once quoted or booked.
  actualCents    Int?
  /// What has been handed over so far — deposits and part payments.
  paidCents      Int       @default(0)
  dueDate        DateTime?
  listingId      String?
  /// Set when this item was created by booking an inquiry, so the write-back
  /// is idempotent: re-booking updates the same row rather than duplicating it.
  inquiryId      String?   @unique
  createdAt      DateTime  @default(now())

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listing  Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  inquiry  Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Timeline. Generated from the event template, backfilled from the event date.
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  DONE
}

model Task {
  id         String           @id @default(cuid())
  eventId    String
  title      String
  notes      String?
  dueDate    DateTime?
  /// Days before the event this is due. Kept alongside dueDate so the timeline
  /// can be recomputed if the event date moves.
  offsetDays Int
  /// Set when this task is "book a <category>", which lets booking an inquiry
  /// close the matching task automatically.
  category   ListingCategory?
  status     TaskStatus       @default(TODO)
  source     RowSource        @default(GENERATED)
  createdAt  DateTime         @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
}

// ---------------------------------------------------------------------------
// Guests. RSVP is public and token-addressed — guests never have accounts.
// ---------------------------------------------------------------------------

enum RsvpStatus {
  INVITED
  ATTENDING
  DECLINED
  MAYBE
  /// Asked to join an approval-required event; the host hasn't decided.
  PENDING
  /// Wants in; the event was full. Promoted in order when a seat frees.
  WAITLISTED
}

model Guest {
  id                 String     @id @default(cuid())
  eventId            String
  /// Set when this row is a registration by an account (the public Register
  /// button). Null for names the host added to the list themselves.
  userId             String?
  name               String
  email              String?
  rsvpStatus         RsvpStatus @default(INVITED)
  plusOnes           Int        @default(0)
  dietary            String?
  note               String?
  /// The invitation link's secret. Code sets it from random bytes
  /// (lib/tokens.ts); the cuid default is only a safety net.
  rsvpToken          String     @unique @default(cuid())
  respondedAt        DateTime?
  /// Set when door staff tap Check in. Null means not yet through the door.
  checkedInAt        DateTime?
  /// True when they were admitted without ever having RSVP'd yes. Frozen at
  /// the door rather than derived later, because rsvpStatus can still be
  /// edited afterwards and the whole point is to keep the two apart.
  arrivedWithoutRsvp Boolean    @default(false)
  createdAt          DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Day-of run sheet.
// ---------------------------------------------------------------------------

/// What actually happened, frozen once when an event finishes.
///
/// Every count in the app today is recomputed at request time and thrown
/// away, so nothing survives to learn from. This is the training set: what we
/// expected against what came through the door. Written once by
/// lib/outcomes.ts and never updated.
model EventOutcome {
  id               String   @id @default(cuid())
  eventId          String   @unique
  /// What the app predicted before the night, from lib/guests.ts.
  expectedHeads    Int
  /// Guests who had said yes by the time the event closed.
  attendingAtClose Int
  /// Guests actually admitted.
  checkedIn        Int
  /// Of those admitted, how many never RSVP'd yes.
  walkUps          Int
  /// The host's planned headcount, which doubles as capacity.
  capacity         Int
  /// Competing events at the host's school that day, when the host is a
  /// student. Null when we don't know the school.
  campusConflicts  Int?
  completedAt      DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([completedAt])
}

model RunSheetItem {
  id        String    @id @default(cuid())
  eventId   String
  startsAt  DateTime
  title     String
  owner     String?
  notes     String?
  createdAt DateTime  @default(now())
  source    RowSource @default(GENERATED)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
}
